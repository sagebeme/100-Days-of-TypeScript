{
  "manifest_version": 3,
  "name": "Focus Mode",
  "version": "1.0.0",
  "description": "Blocks the sites that eat your time, during the hours you choose.",
  "action": { "default_popup": "popup.html", "default_title": "Focus Mode" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "declarativeNetRequest", "alarms"],
  "host_permissions": ["*://*/*"],
  "icons": { "128": "icon.svg" },
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }]
}
